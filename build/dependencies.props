<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="LhaForgeDependencies">
    <LhaForgeDependencyRoot Condition="'$(LhaForgeDependencyRoot)'==''">$(MSBuildThisFileDirectory)..\.deps\</LhaForgeDependencyRoot>
    <LhaForgeWTLVersion Condition="'$(LhaForgeWTLVersion)'==''">9.1.5321</LhaForgeWTLVersion>
    <LhaForgeWTLRoot>$(LhaForgeDependencyRoot)wtl\$(LhaForgeWTLVersion)\</LhaForgeWTLRoot>
    <LhaForgeWTLInclude>$(LhaForgeWTLRoot)Include\</LhaForgeWTLInclude>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(LhaForgeWTLInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(LhaForgeWTLInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <Target Name="ValidateLhaForgeDependencies" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(LhaForgeWTLInclude)atlapp.h')"
      Text="WTL $(LhaForgeWTLVersion) is not restored. Run: powershell -NoProfile -ExecutionPolicy Bypass -File .\tools\restore-wtl.ps1" />
    <Error
      Condition="!Exists('$(LhaForgeWTLInclude)atlres.h')"
      Text="WTL resource header atlres.h is missing. Restore WTL $(LhaForgeWTLVersion) again with tools\restore-wtl.ps1." />
  </Target>
</Project>
